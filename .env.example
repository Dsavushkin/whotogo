# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Токен бота от @BotFather
BOT_TOKEN=
BOT_USERNAME=whotogobot
# Если сервер в России не достаёт до Telegram: адрес своего посредника за рубежом
# (он пересылает запросы на https://api.telegram.org) или прокси.
TELEGRAM_API_BASE=
TELEGRAM_PROXY=

# Адрес сервера без https://. Пусто — возьмём бесплатный вида 1-2-3-4.sslip.io
DOMAIN=
# Telegram ID администраторов через запятую (узнать: команда /id в боте)
ADMIN_IDS=

# Токен Timepad для афиши: https://dev.timepad.ru → «Получить токен». Пусто — парсер выключен.
TIMEPAD_TOKEN=
TIMEPAD_CITY=Москва

# Для страниц «Соглашение» и «Конфиденциальность»
OPERATOR_NAME=ООО «САВУШКИН»
CONTACT_EMAIL=da.savushkin4@gmail.com

# Пароль базы данных: придумывается при установке, менять не нужно
POSTGRES_PASSWORD=
